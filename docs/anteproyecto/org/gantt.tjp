project nil "Proyecto Final" "1.0" 2025-06-15 +280d {
  extend resource{text Phone "Phone"}
}
shift s40 "Part time shift" {
  workinghours wed, thu, fri off
}
account esbon1253 "" {
}
resource esteban "Esteban Bustamante" {
  email "ebustamante896@gmail.com"
  Phone "3804547618"
}
task proyecto "Proyecto Final" {
  purge allocate
  allocate esteban
  start 2025-06-15
  task start "Inicio de Proyecto" {
    milestone
  }
  task inv "Investigación" {
    depends !start
    task preparaci_n "Preparación del Flujo de Trabajo" {
      complete 100
      effort 1w
    }
    task lectura "Lectura de literatura específica" {
      depends !preparaci_n
      effort 3w
    }
  }
  task dis "Diseño" {
    depends !inv
    task dise_o "Diseño del Firmware" {
      effort 1m
    }
    task dise_o_del "Diseño del Sistema Operativo" {
      depends !dise_o
      effort 1m
    }
  }
  task imp "Implementación básica" {
    depends !dis
    task implementaci_n "Implementación del SO" {
      effort 1m
    }
    task implementaci_n_del "Implementación del firmware" {
      depends !implementaci_n
      effort 1m
    }
  }
  task doc "Documentación" {
    depends !dis
    task generaci_n "Generación de benchmarks" {
      effort 1w
    }
    task redacci_n "Redacción Informe final" {
      depends !generaci_n
      effort 3w
    }
  }
}
navigator navbar {
  hidereport @none
}

textreport frame "" {
  header -8<-
    == PROYECTO FINAL - UTN Facultad Regional La Rioja ==
    <[navigator id="navbar"]>
  ->8-  
  footer "----"

textreport inicio "index"{
formats html
center -8<- 
    == Firmware de un decodificador MPEG-2 implementado en FPGA==
El objetivo de este proyecto  realización del firmware de un decodificador MPEG-2 para la obtención del título de grado en Ingeniería Electrónica. Se muestra en la siguiente figura el sistema de microprocesadores con el que se
va a trabajar. 

[[File:/home/esbon1253/Documents/tandem/docs/propuesta/figures/1.jpg]]



->8-
}

textreport index "Trayectoria del proyecto" {
  formats html
  center -8<-
    === Plan del Proyecto ===
    <[report id="plan"]>
  ->8-
}
textreport "Recursos"{
	   formats html
	   center -8<-
	   === Asignacion de Recursos ===
	   <[report id="resourceGraph"]>
	   ->8-
}
  textreport "ContactList" {
    formats html
    title "Lista de Contactos"
    center '<[report id="contactList"]>'
  }
}



resourcereport contactList "" {
  scenarios plan
  headline "Lista de contactos y esquema de tareas"
  columns name,
          email { celltext 1 "[mailto:<-email-> <-email->]" },
          Phone,
          chart { scale day }
  hideresource ~isleaf()
  sortresources name.up
  hidetask @all
}

# A traditional Gantt chart with a project overview.
taskreport plan "" {
  headline "Plan del Proyecto"
  columns bsi, name, start, end, effort, chart
  loadunit shortauto
  hideresource 1
}

# A graph showing resource allocation. It identifies whether each
# resource is under- or over-allocated for.
resourcereport resourceGraph "" {
  headline "Gráfica de Asignación de Recursos"
  columns no, name, effort, weekly
  loadunit shortauto
  hidetask ~(isleaf() & isleaf_())
  sorttasks plan.start.up
}
