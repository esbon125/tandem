# Doxygen configuration for the mpeg2fpga Reference Manual. Run from doxygen/:
#   make            (or: doxygen Doxyfile)
# Only settings that differ from Doxygen's defaults are listed.

PROJECT_NAME           = "mpeg2fpga Reference Manual"
PROJECT_BRIEF          = "MPEG-2 video decoder on PolarFire SoC: driver, service and client library"
PROJECT_NUMBER         = $(MPEG2FPGA_VERSION)
OUTPUT_DIRECTORY       = build
STRIP_FROM_PATH        = ..
FULL_PATH_NAMES        = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_INCOMPLETE_DOC = NO
WARN_LOGFILE           = build/warnings.log

INPUT                  = mainpage.md \
                         ../driver/mpeg2fpga \
                         ../daemon/native/m2fconv.c \
                         ../daemon/mpeg2fpgad \
                         ../api/python/src/mpeg2fpga
FILE_PATTERNS          = *.c *.h *.py *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = *.mod.c */__pycache__/* */_version.py
USE_MDFILE_AS_MAINPAGE = mainpage.md
FILTER_PATTERNS        = "*.c=python3 kerneldoc_filter.py" "*.h=python3 kerneldoc_filter.py"

SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg
